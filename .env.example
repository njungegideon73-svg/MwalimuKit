# ──────────────────────────────────────────────
# MwalimuKit — Environment Configuration
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# API
API_ENV=production
API_PORT=8000
API_SECRET_KEY=GENERATE_A_STRONG_SECRET_HERE
API_CORS_ORIGINS=https://your-frontend.vercel.app

# Database (Supabase provides this)
DATABASE_URL=postgresql+psycopg://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Redis (Upstash free tier or Render Redis)
REDIS_URL=redis://default:password@redis-12345.upstash.io:6379/0

# AI provider (openai | anthropic)
AI_PROVIDER=openai
AI_API_KEY=sk-xxxxxxxxxxxx
AI_MODEL=gpt-4o-mini

# Stripe (optional — leave empty to disable billing)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
FRONTEND_URL=https://your-frontend.vercel.app

# Feature flags
FEATURE_PAYWALL_ENABLED=false
FEATURE_AI_GENERATION_ENABLED=true

# ── Observability ─────────────────────────────
# Error tracking — leave empty to disable
SENTRY_DSN=https://your-key@sentry.io/project-id
# Cache TTL for read-heavy endpoints (seconds)
CACHE_TTL_SECONDS=300

# ── API Rate limiting ─────────────────────────
# Login attempts before lockout (default: 5)
AUTH_LOCKOUT_MAX_FAILURES=5
# Lockout duration in seconds (default: 900)
AUTH_LOCKOUT_DURATION_SECONDS=900

# ── Frontend (Vercel) ────────────────────────
VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_APP_NAME=MwalimuKit
