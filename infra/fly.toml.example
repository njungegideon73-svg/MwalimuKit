# Fly.io deployment configuration example
# Copy this to fly.toml and adjust values for your deployment.

app = "mwalimukit-api"
primary_region = "nairobi"

[build]

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 0

  [http_service.concurrency]
    type = "connections"
    hard_limit = 250
    soft_limit = 200

[[vm]]
  cpu_kind = "shared"
  cpus = 1
  memory_mb = 256

[env]
  API_ENV = "production"
